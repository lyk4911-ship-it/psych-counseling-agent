# Copy to .env and enter values locally. Never commit .env.
# Either key name is accepted. Account/history features work without a model key.
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Required only for /admin and /tester; independent from registered user accounts.
ADMIN_USER=
ADMIN_PASS=
TESTER_TOKEN=

# Set to 1 for an HTTPS deployment. Leave 0 only for local HTTP development.
COOKIE_SECURE=0

# Optional: default is <repository>/data/accounts.sqlite3.
# APP_DB_PATH=/absolute/path/to/accounts.sqlite3

# Normally keep the UI and API on the same origin.
# CORS_ORIGINS=https://your-frontend.example
